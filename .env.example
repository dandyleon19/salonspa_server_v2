# R2DBC (reactive app runtime)
DB_URL=r2dbc:postgresql://localhost:5432/salonspa_webflux

# JDBC (Flyway migrations only — same database, different driver)
JDBC_URL=jdbc:postgresql://localhost:5432/salonspa_webflux

DB_USERNAME=postgres
DB_PASSWORD=root

# Baseline existing DBs that were created with schema.sql (set false on fresh DB if needed)
FLYWAY_BASELINE_ON_MIGRATE=true

# JWT (minimum 32 characters for HS256)
JWT_SECRET=change-me-to-a-long-random-secret-key-at-least-32-chars
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=604800000

# CORS (comma-separated browser origins allowed to call the API)
# Include every frontend that calls the API from the browser (scheme + host + port).
# Example: public site dominio.com + admin app app.dominio.com
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://dominio.com,https://www.dominio.com,https://app.dominio.com

# Flyway uses JDBC_URL / DB_USERNAME / DB_PASSWORD (required with R2DBC)

# Logging
R2DBC_LOG_LEVEL=INFO
